# private: the brain's own open model. It may read local-only memory, so it is reached
# only through an SSH tunnel to an address of the owner's, and the brain uses it as its
# spoke (OLLAMA_SPOKE_URL). One model, chosen once; change it here, not per sitting.
PORT=11500
MODEL=gpt-oss:20b
MAX_MIN=120
SPOKE=1
DISK_GB=60
